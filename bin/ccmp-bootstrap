#!/usr/bin/env python3
"""ccmp bootstrap — ensure daemon deps exist (venv + memory-skill + model).

One-shot setup: hooks call this lazily when the daemon is unreachable, so a
fresh plugin install works without manual steps. Fail-open by design: every
failure exits 0 and logs to stderr so a bootstrap hiccup never breaks the
agent session.

Env knobs:
  CCMP_SKIP_BOOTSTRAP=1   skip everything
  CCMP_VENV_DIR           venv location (default: <plugin_root>/.venv)
  CCMP_PYTHON             python interpreter to build venv from
                          (default: probe python3 / py -3 / python)
  CCMP_SKIP_INSTALL=1     skip pip install
  CCMP_SKIP_MODEL=1       skip model download
  HF_ENDPOINT             huggingface endpoint (hf-mirror.com fallback on failure)
"""

from __future__ import annotations

import os
import subprocess
import sys

PLUGIN_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
VENV_DIR = os.environ.get("CCMP_VENV_DIR", os.path.join(PLUGIN_ROOT, ".venv"))

# memory-skill's own download script path resolution at import time points at
# the installed package; we model under the venv's site-packages default.
MODEL_ID = "BAAI/bge-large-en-v1.5"

IS_WIN = os.name == "nt"


def log(*args) -> None:
    print("[ccmp-bootstrap]", *args, file=sys.stderr, flush=True)


def run(cmd: list[str], **kw) -> subprocess.CompletedProcess:
    log("run:", " ".join(cmd))
    return subprocess.run(cmd, text=True, **kw)


def base_cmd() -> list[str]:
    """Interpreter used to create the venv (CCMP_PYTHON overrides probing)."""
    env = os.environ.get("CCMP_PYTHON", "").strip()
    if env:
        return [env]
    if IS_WIN:
        for cand in (["py", "-3"], ["python"]):
            try:
                r = run(cand + ["-c", "pass"], capture_output=True)
                if r.returncode == 0:
                    return cand
            except Exception:  # noqa: BLE001
                continue
        return ["python"]
    return ["python3"]


def venv_python() -> str:
    if IS_WIN:
        return os.path.join(VENV_DIR, "Scripts", "python.exe")
    return os.path.join(VENV_DIR, "bin", "python")


def onnx_present(model_dir: str) -> bool:
    return os.path.isfile(os.path.join(model_dir, "model.onnx")) or os.path.isfile(
        os.path.join(model_dir, "onnx", "model.onnx")
    )


def _venv_usable() -> bool:
    py = venv_python()
    if not os.path.exists(py):
        return False
    probe = run([py, "-c", "import pip"], capture_output=True)
    return probe.returncode == 0


def main() -> None:
    if os.environ.get("CCMP_SKIP_BOOTSTRAP") == "1":
        log("skipped (CCMP_SKIP_BOOTSTRAP=1)")
        return

    # An externally supplied CCMP_PYTHON (e.g. an existing memory-skill venv)
    # replaces bootstrap's own venv entirely.
    external = os.environ.get("CCMP_PYTHON", "").strip()
    if external:
        log(f"using external CCMP_PYTHON: {external}")
        _ensure_deps_external(external)
        _ensure_model(external)
        return

    if _venv_usable():
        log(f"venv usable: {VENV_DIR}")
        _ensure_deps()
        _ensure_model(venv_python())
        return

    log(f"creating venv at {VENV_DIR}")
    r = run(base_cmd() + ["-m", "venv", VENV_DIR])
    if r.returncode != 0 or not _venv_usable():
        log("venv creation failed (continuing)")
        return

    _ensure_deps()
    _ensure_model(venv_python())


def step(name: str) -> bool:
    skip = os.environ.get(f"CCMP_SKIP_{name.upper().replace(' ', '_')}", "")
    return skip == "1"


def _ensure_deps(py: str | None = None) -> None:
    if step("install"):
        log("skipped install")
        return
    py = py or venv_python()
    r = run([py, "-m", "pip", "install", "-q",
             "memory-skill[onnx]", "starlette", "uvicorn", "mcp>=1.28,<2"])
    if r.returncode != 0:
        log("pip install failed (continuing)")


def _ensure_deps_external(py: str) -> None:
    if step("install"):
        log("skipped install")
        return
    r = run([py, "-m", "pip", "install", "-q",
             "memory-skill[onnx]", "starlette", "uvicorn", "mcp>=1.28,<2"])
    if r.returncode != 0:
        log("pip install on external python failed (continuing)")


def _ensure_model(py: str) -> None:
    if step("model"):
        log("skipped model")
        return
    probe = run(
        [py, "-c",
         "import memory_skill.contracts as c; print(c.MemorySkillConfig().model_path)"],
        capture_output=True,
    )
    if probe.returncode != 0:
        log("model probe failed (continuing)")
        return
    model_dir = probe.stdout.strip()
    if onnx_present(model_dir):
        log(f"model present: {model_dir}")
        return
    log("model missing — installing downloader deps + fetching bge-large-en-v1.5 (~1.3GB)")
    run([py, "-m", "pip", "install", "-q", "optimum[onnxruntime]", "huggingface_hub"],
        capture_output=True)
    download = run(
        [py, "-c",
         "import os\n"
         "from huggingface_hub import snapshot_download\n"
         f"snapshot_download(repo_id='{MODEL_ID}', local_dir={model_dir!r})"],
        capture_output=True,
    )
    if download.returncode != 0 and os.environ.get("HF_ENDPOINT", "").strip() == "":
        log("model download failed; retrying via hf-mirror.com")
        run(
            [py, "-c",
             "import os\n"
             "os.environ['HF_ENDPOINT']='https://hf-mirror.com'\n"
             "from huggingface_hub import snapshot_download\n"
             f"snapshot_download(repo_id='{MODEL_ID}', local_dir={model_dir!r})"],
            capture_output=True,
        )
    if not onnx_present(model_dir):
        log("converting to ONNX (optimum)...")
        conv = run(
            [py, "-m", "optimum.onnxruntime",
             "--model", model_dir, "--task", "feature-extraction", model_dir],
            capture_output=True,
        )
        if conv.returncode != 0:
            log("ONNX conversion failed — memory runs DEGRADED (hash-only search)")


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:  # noqa: BLE001 — fail-open contract
        log("bootstrap crashed (fail-open, continuing):", exc)
    sys.exit(0)
